# Seeed Studio XIAO ePaper Display Board EE03 (10.3" mono IT8951, GC16)
CONFIG_BOARD_DRIVER_SEEEDSTUDIO_XIAO_EE03=y

# Flash Configuration (XIAO ESP32-S3 Plus: 16MB with 80MHz)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Internal flash storage (LittleFS) — no microSD slot on this board.
CONFIG_USE_INTERNAL_FLASH_STORAGE=y

# Note: OPI PSRAM (needed for the IT8951 1872x1404 4bpp framebuffer, ~1.3 MB)
# is enabled globally in sdkconfig.defaults.
