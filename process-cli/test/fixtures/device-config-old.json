{
  "config": {
    "device_name": "PhotoFrame",
    "timezone": "UTC0",
    "display_orientation": "landscape",
    "rotation_mode": "url"
  },
  "processing": {
    "exposure": 1,
    "saturation": 1.2,
    "toneMode": "contrast",
